        <mxCell id="n60" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAEAEA;strokeColor=#666666;fontColor=#333333;fontSize=9;fontStyle=0;align=left;valign=middle;dashed=0;arcSize=8;" value="&lt;font style=&quot;font-size: 12px;&quot;&gt;VPC Endpoints: ECR . S3 . STS . SSM . EC2 . Auto Scaling . ELB (Gateway / Interface). Keeps AWS API traffic on the private AWS network, reduces NAT dependency and blast radius.&lt;/font&gt;" vertex="1">
          <mxGeometry height="45" width="1580" x="60" y="780" as="geometry" />
        </mxCell>
        <mxCell id="n65" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4ECF7;strokeColor=#8C4FFF;fontColor=#8C4FFF;fontSize=8;fontStyle=0;align=center;valign=middle;dashed=0;arcSize=8;" value="&lt;font style=&quot;font-size: 12px;&quot;&gt;Route 53 ARC, Zonal Shift auto-evacuates an impaired AZ, monitors AZ health&lt;/font&gt;" vertex="1">
          <mxGeometry height="55" width="260" x="280" y="163" as="geometry" />
        </mxCell>
        <mxCell id="n74" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#000000;fontSize=9;fontStyle=2;align=left;valign=top;dashed=0;arcSize=8;" value="&lt;span style=&quot;font-style: normal;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;ALB is Multi-AZ, cross-zone load balanced. A single AZ failure does not remove the service from rotation.&lt;/font&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="60" width="260" x="860" y="100" as="geometry" />
        </mxCell>
        <mxCell id="n75" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#000000;fontSize=9;fontStyle=2;align=left;valign=top;dashed=0;arcSize=8;" value="&lt;span style=&quot;font-style: normal;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Karpenter: right-sized Spot + On-Demand nodes in under 60s, topology-spread across AZs. Zero manual node scaling.&lt;/font&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="60" width="260" x="720" y="644" as="geometry" />
        </mxCell>
        <mxCell id="n76" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#000000;fontSize=9;fontStyle=2;align=left;valign=top;dashed=0;arcSize=8;" value="&lt;span style=&quot;font-style: normal;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;VPC endpoints: All traffic remains inside AWS Network&lt;/font&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="55" width="260" x="1240" y="775" as="geometry" />
        </mxCell>
        <mxCell id="n78" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#DD344C;fontColor=#333333;fontSize=9;fontStyle=0;align=left;valign=top;dashed=0;arcSize=8;" value="&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Security, Least Privilege &amp;amp; Defense in Depth&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;- EKS API server: private endpoint, no public access&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;br&gt;- Security Groups: least privilege, scoped to VPC CIDR, TLS only&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;br&gt;- IRSA / EKS Pod Identity: per-pod least-privilege IAM&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;br&gt;- KMS: encrypts EKS secrets (etcd), EBS, DynamoDB, ElastiCache&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;br&gt;- AWS WAF at the edge: OWASP Top 10 rules + rate limiting&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;br&gt;- Secrets Manager + External Secrets Operator for app secrets&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="205" width="425" x="340" y="915" as="geometry" />
        </mxCell>
        <mxCell id="n79" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontColor=#333333;fontSize=9;fontStyle=0;align=left;valign=top;dashed=0;arcSize=8;" value="&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Reliability, Spikes, Zero Manual Intervention&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;- HPA / KEDA scale pods on CPU + queue depth within seconds&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;br&gt;- Karpenter scales nodes to match pending pods, Spot+On-Demand mix&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;br&gt;- PodDisruptionBudgets + topologySpreadConstraints keep quorum&lt;/font&gt;&lt;span style=&quot;font-size: 12px; background-color: transparent; color: light-dark(rgb(51, 51, 51), rgb(193, 193, 193));&quot;&gt;&amp;nbsp;through node churn, AZ loss, or rolling deploys&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 12px; background-color: transparent; color: light-dark(rgb(51, 51, 51), rgb(193, 193, 193));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;- ArgoCD auto-sync + self-heal reverts bad or drifted deployments&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;br&gt;- Route 53 ARC zonal shift evacuates an impaired AZ in minutes&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="205" width="425" x="960" y="915" as="geometry" />
        </mxCell>
        <mxCell id="ViW9WWyZkVS-0RxFy4aG-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Network Diagram" vertex="1">
